{
  "name": "register-automation-test",
  "version": "1.0.0",
  "description": "Automation test project for registration flow using Puppeteer",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:dev": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:single": "jest --testNamePattern",
    "test:custom": "jest tests/integration/customData.test.js",
    "test:multistep": "jest tests/integration/multiStep.test.js",
    "setup": "node scripts/setup.js",
    "start": "node src/index.js",
    "example:custom": "node examples/customRegistrationTest.js",
    "example:simple": "node examples/simpleUsage.js",
    "example:multistep": "node examples/multiStepRegistration.js",
    "example:debug": "node examples/multiStepRegistration.js --step-by-step",
    "example:auto": "node examples/multiStepRegistration.js --auto",
    "example:real": "node examples/realSiteTest.js",
    "example:debug-selectors": "node examples/realSiteTest.js --debug-selectors",
    "example:manual-otp": "node examples/manualOtpTest.js",
    "example:otp-step": "node examples/manualOtpTest.js --step-by-step",
    "example:quick-otp": "node examples/manualOtpTest.js --quick",
    "example:terminal-otp": "node examples/terminalOtpTest.js",
    "example:terminal-otp-help": "node examples/terminalOtpTest.js --help"
  },
  "keywords": [
    "automation",
    "testing",
    "puppeteer",
    "registration",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "jest": "^26.6.3",
    "puppeteer": "^10.4.0",
    "eslint": "^7.32.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=12.0.0",
    "npm": ">=6.0.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup/jest.setup.js"
    ],
    "testTimeout": 30000,
    "testEnvironment": "node"
  }
}
