{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript API Automation Framework focused on BankGW",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:api:dev": "cross-env ENV=dev playwright test --project=api",
    "test:api:uat": "cross-env ENV=uat playwright test --project=api",
    "test:api:bankgw": "playwright test --project=api tests/api/bankgw",
    "test:api:bankgw:live": "cross-env RUN_BANKGW_API_TESTS=true playwright test --project=api tests/api/bankgw",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:env": "node scripts/prepare-env.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "api-testing",
    "bankgw"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "zod": "^3.24.2"
  }
}
